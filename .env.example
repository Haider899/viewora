 # VistaraX Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# For local development with zero dependencies:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/vistarax?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_characters_long_example
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Feature Flags
ENABLE_REWARDS=true
ENABLE_REFERRAL_COMMISSIONS=true
ENABLE_CRYPTO_PAYMENTS=true
MAINTENANCE_MODE=false

# System Initial Credentials (for database seed)
ADMIN_EMAIL=admin@vistarax.com
ADMIN_PASSWORD=AdminSecurePass2026!
FINANCE_ADMIN_EMAIL=finance@vistarax.com
CONTENT_ADMIN_EMAIL=content@vistarax.com
SUPPORT_AGENT_EMAIL=support@vistarax.com

# Payout & Commission Rates
DEFAULT_COMMISSION_PERCENT=5.0
DEFAULT_USD_TO_PKR_RATE=280.00
