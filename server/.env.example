# VistaraX Server Environment Configuration
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration (SQLite file for dev/self-hosted; PostgreSQL connection for production)
DATABASE_URL="file:./dev.db"

# Authentication Secrets (generate secure random 64-character strings for production)
JWT_ACCESS_SECRET=vistarax_super_secret_access_jwt_key_2026_secure
JWT_REFRESH_SECRET=vistarax_super_secret_refresh_jwt_key_2026_secure
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Feature Flags
ENABLE_REWARDS=true
ENABLE_REFERRAL_COMMISSIONS=true
ENABLE_CRYPTO_PAYMENTS=true
MAINTENANCE_MODE=false

# System Initial Credentials (for seed script)
ADMIN_EMAIL=admin@vistarax.com
ADMIN_PASSWORD=VistaraSecure2026!

# Payout & Commission Rates
DEFAULT_COMMISSION_PERCENT=5.0
DEFAULT_USD_TO_PKR_RATE=280.00

